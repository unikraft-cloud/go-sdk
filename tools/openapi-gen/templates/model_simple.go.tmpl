{{define "model_simple" -}}
import (
	"github.com/go-json-experiment/json"
	"github.com/go-json-experiment/json/jsontext"
)

{{$schema := .Schema}}
{{$schemaName := .SchemaName}}
{{$propNames := propertyNamesOrdered $schemaName $schema}}
{{- /* Inline enum types for fields */ -}}
{{- range $propName := $propNames -}}
{{- $prop := getProperty $schema $propName}}
{{- $enumSchema := ""}}
{{- $enumDescription := ""}}
{{- if and $prop $prop.Enum}}
{{- /* Direct enum property */}}
{{- $enumSchema = $prop}}
{{- $enumDescription = $prop.Description}}
{{- else if and $prop (eq (getType $prop) "array") $prop.Items $prop.Items.Value $prop.Items.Value.Enum}}
{{- /* Array of enum items - description is on the property, not items */}}
{{- $enumSchema = $prop.Items.Value}}
{{- $enumDescription = $prop.Description}}
{{- end}}
{{- if $enumSchema}}
{{- $enumTypeName := schemaToGoType $enumSchema }}
{{- if $enumDescription -}}
// {{$enumDescription | replace "\n" "\n// "}}
{{end -}}
type {{$enumTypeName}} string

const (
{{- range $enumSchema.Enum}}
	{{$enumTypeName}}{{pascalcase (printf "%v" .)}} {{$enumTypeName}} = {{printf "%q" .}}
{{- end}}
)
{{ end }}

{{- end}}
{{- if $schema.Description}}
// {{$schema.Description | replace "\n" "\n// "}}
{{- end}}
type {{$schemaName}} struct {
{{- range $propName := propertyNamesOrdered $schemaName $schema}}
{{- $prop := getProperty $schema $propName}}
{{- if $prop}}
{{- /* Render description for all properties, including array enums */}}
{{- if $prop.Description}}
	// {{$prop.Description | replace "\n" "\n	// "}}
{{- end}}
{{- $required := getPropertyRequired $schema $propName}}
{{- $propGoName := pascalcase $propName}}
{{- $openAPIType := getType $prop}}
{{- /* Determine the Go type */}}
{{- $propType := schemaToGoType $prop }}
{{- /* Add pointer for optional fields */}}
{{- if not $required}}
	{{- if and (ne $openAPIType "array") (ne $openAPIType "object")}}
		{{- $propType = printf "*%s" $propType}}
	{{- end}}
{{- end}}
	{{$propGoName}} {{$propType}} `json:"{{$propName}}{{if not $required}},omitempty{{end}}"`
{{- end}}
{{- end}}

	// AdditionalProperties captures any JSON object members that do not map to
	// an explicit field above.
	AdditionalProperties map[string]jsontext.Value `json:",inline"`
}

{{/* ensure that callers using encoding/json don't break */}}
func (m *{{$schemaName}}) UnmarshalJSON(data []byte) error {
	type Alias {{$schemaName}}
	return json.Unmarshal(data, (*Alias)(m))
}

func (m {{$schemaName}}) MarshalJSON() ([]byte, error) {
	type Alias {{$schemaName}}
	return json.Marshal((Alias)(m))
}
{{- end}}
