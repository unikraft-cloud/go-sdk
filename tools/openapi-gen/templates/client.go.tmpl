func (c *client) {{$op.OperationID}}(ctx context.Context
{{- range $pathParams}}, {{camelcase .Name}} {{paramToGoType .}}{{end}}
{{- if $hasRequestBody}}, request {{if $requestBodyIsArray}}[]{{end}}{{$requestBodyType}}{{end}}
{{- if $queryParams}}, opts {{$op.OperationID}}Opts{{end}}) ({{if $isSSE}}<-chan {{end}}*Response[{{if $responseHasData}}{{$responseType}}Data{{else}}any{{end}}], error) {
	requestPath := "{{$path}}"
{{- range $pathParams}}
	requestPath = strings.ReplaceAll(requestPath, "{{"{"}}{{.Name}}{{"}"}}", url.PathEscape(string({{camelcase .Name}})))
{{- end}}

{{- if $queryParams}}

	query := make(url.Values)
{{- range $queryParams}}
{{- if and .Schema .Schema.Value (eq (getType .Schema.Value) "array")}}
{{- $itemType := ""}}
{{- if and .Schema.Value.Items .Schema.Value.Items.Value}}{{$itemType = getType .Schema.Value.Items.Value}}{{end}}
	for _, v := range opts.{{pascalcase .Name}} {
{{- if eq $itemType "integer"}}
		query.Add("{{.Name}}", fmt.Sprintf("%d", v))
{{- else if eq $itemType "boolean"}}
		query.Add("{{.Name}}", fmt.Sprintf("%t", v))
{{- else if eq $itemType "number"}}
		query.Add("{{.Name}}", fmt.Sprintf("%g", v))
{{- else}}
		query.Add("{{.Name}}", string(v))
{{- end}}
	}
{{- else if and .Schema .Schema.Value (eq (getType .Schema.Value) "boolean")}}
{{- if not .Required}}
	if opts.{{pascalcase .Name}} != nil {
		query.Add("{{.Name}}", fmt.Sprintf("%t", *opts.{{pascalcase .Name}}))
	}
{{- else}}
	query.Add("{{.Name}}", fmt.Sprintf("%t", opts.{{pascalcase .Name}}))
{{- end}}
{{- else if and .Schema .Schema.Value (eq (getType .Schema.Value) "integer")}}
{{- if not .Required}}
	if opts.{{pascalcase .Name}} != nil {
		query.Add("{{.Name}}", fmt.Sprintf("%d", *opts.{{pascalcase .Name}}))
	}
{{- else}}
	query.Add("{{.Name}}", fmt.Sprintf("%d", opts.{{pascalcase .Name}}))
{{- end}}
{{- else if and .Schema .Schema.Value (eq (getType .Schema.Value) "number")}}
{{- if not .Required}}
	if opts.{{pascalcase .Name}} != nil {
		query.Add("{{.Name}}", fmt.Sprintf("%g", *opts.{{pascalcase .Name}}))
	}
{{- else}}
	query.Add("{{.Name}}", fmt.Sprintf("%g", opts.{{pascalcase .Name}}))
{{- end}}
{{- else}}
{{- if not .Required}}
	if opts.{{pascalcase .Name}} != nil {
		query.Add("{{.Name}}", string(*opts.{{pascalcase .Name}}))
	}
{{- else}}
	query.Add("{{.Name}}", string(opts.{{pascalcase .Name}}))
{{- end}}
{{- end}}
{{- end}}
{{- end}}

{{- if $hasRequestBody}}
{{- if $requestBodyIsArray}}

	var body []byte
