	if request != nil {
		body, err = json.Marshal(request)
		if err != nil {
			return nil, fmt.Errorf("error marshalling request body: %w", err)
		}
	}
{{- else}}

	body, err := json.Marshal(request)
	if err != nil {
		return nil, fmt.Errorf("error marshalling request body: %w", err)
	}
{{- end}}
{{- end}}

	resp := &Response[{{if $responseHasData}}{{$responseType}}Data{{else}}any{{end}}]{}
	if err := doRequest[{{if $responseHasData}}{{$responseType}}Data{{else}}any{{end}}](ctx, c.request, http.Method{{title (lower $method)}}, requestPath, {{if $queryParams}}query{{else}}nil{{end}}, {{if $hasRequestBody}}bytes.NewReader(body){{else}}nil{{end}}, resp); err != nil {
{{- if $isSSE}}
		return nil, fmt.Errorf("performing the request: %w", err)
{{- else}}
{{- if eq $pkg "platform"}}
